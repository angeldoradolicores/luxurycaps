NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=your-wompi-public-key
WOMPI_PRIVATE_KEY=your-wompi-private-key
# Firma de integridad (Wompi → Desarrolladores → Secretos para integración técnica). NUNCA con prefijo NEXT_PUBLIC_
WOMPI_INTEGRITY_KEY=your-wompi-integrity-secret
# Secreto de eventos para verificar el checksum del webhook. NUNCA con prefijo NEXT_PUBLIC_
WOMPI_EVENTS_SECRET=your-wompi-events-secret
# URL pública canónica del sitio (redirect-url de Wompi)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
